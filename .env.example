# CyberMemory AI environment configuration
# Copy to .env and replace placeholders before using external services.

# Dashboard Flask server
PORT=5000
FLASK_ENV=development
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=replace_with_a_random_secret_key

# Optional dashboard API proxy
# BACKEND_API_URL=http://localhost:8000

# Groq LLM inference
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight memory (REQUIRED for live memory; without it a local fallback bank is used)
# Hindsight Cloud: sign up at https://ui.hindsight.vectorize.io and copy your API URL + key.
# Self-hosted: HINDSIGHT_URL=http://localhost:8888 and leave the key empty.
HINDSIGHT_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_DEFAULT_BANK_ID=cybermemory_soc_demo

# Backend safety policy
OPERATIONAL_MODE=READ_ONLY_ANALYSIS
