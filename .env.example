# ==============================================================================
# CyberMemory AI - Environment Configuration Example
# Copy this file to .env and set your credentials. Never commit .env to GitHub.
# ==============================================================================

# Vectorize Hindsight Persistent Agent Memory Configuration
# Sign up at https://ui.hindsight.vectorize.io (Use promo code MEMHACK99 for $50 credits)
# Or run open-source Hindsight locally (defaults to http://localhost:8888)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_DEFAULT_BANK_ID=cybermemory_soc_demo

# Groq API Configuration for LLM Inference
# Obtain free tier key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Operational Security Mode
# Options: READ_ONLY_ANALYSIS (Strictly advisory mode)
OPERATIONAL_MODE=READ_ONLY_ANALYSIS

# Application Server Settings
PORT=5000
HOST=0.0.0.0
DEBUG=False
