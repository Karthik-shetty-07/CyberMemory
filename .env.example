# CyberMemory AI - Environment Configuration Example

# Flask Server Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=cybermemory-dev-secret-key-change-in-production

# Backend Service Proxy (Optional - if running separate FastAPI backend)
# BACKEND_API_URL=http://localhost:8000

# Groq LLM Inference (Handled by Backend / AI Service)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen-qwq-32b

# Vectorize Hindsight Persistent Memory (Handled by Backend / Memory Service)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=cybermemory-soc-v1

